# ---- Core ----
NODE_ENV=development
PORT=3001
# Public base URL used in generated links (media, deep links)
PUBLIC_BASE_URL=http://localhost:3001
# Comma-separated list of allowed CORS origins (admin panel, web build of the app)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- Database ----
# Leave empty to use embedded PGlite (PostgreSQL in WASM) stored in ./data/pglite.
# Production MUST set a real PostgreSQL URL.
DATABASE_URL=
# Set to "memory" to use an in-memory PGlite (tests).
PGLITE_DIR=./data/pglite

# ---- Reserved for future distributed workers; currently unused ----
REDIS_URL=

# ---- Auth ----
# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change-me-dev-only-access-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_HMAC_SECRET=change-me-dev-only-otp-secret-change-me
# console | webhook. The HTTPS relay handles SMS and email delivery.
OTP_DELIVERY=console
OTP_WEBHOOK_URL=
OTP_WEBHOOK_TOKEN=
# Echo OTP code in /auth/start response. Ignored when NODE_ENV=production.
OTP_DEV_ECHO=true

# ---- Admin ----
ADMIN_JWT_SECRET=change-me-dev-only-admin-secret-change-me
ADMIN_SESSION_TTL_SECONDS=3600
# Require TOTP MFA for admin login (recommended true in production)
ADMIN_REQUIRE_MFA=false

# ---- Storage ----
# local | s3 | db (db keeps photos in PostgreSQL: for hosts whose disk is wiped on restart)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_PUBLIC=
S3_BUCKET_PROTECTED=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_MAX_BYTES=10485760

# ---- AI layer ----
# auto (default): on-device recognition always; Claude as well when ANTHROPIC_API_KEY is set.
# Other values: local | anthropic | disabled
AI_PROVIDER=auto
# Optional. Adds reading of logos/models and written descriptions.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=30000
# On-device model (45 MB, Apple Sample Code License) is fetched once and checked by SHA-256.
AI_LOCAL_MODEL_DIR=./models
AI_LOCAL_MODEL_DOWNLOAD=true
# Mirror (HTTPS) for networks where huggingface.co is blocked; same file, same checksum.
AI_LOCAL_MODEL_URL=

# ---- Moderation ----
# Listings whose photos the AI could not check (no ANTHROPIC_API_KEY):
# after (default) = published at once, moderators review them afterwards;
# before = hidden until a moderator approves them.
PHOTO_REVIEW=after

# ---- Push ----
# Only console is implemented. In-app notifications work independently.
PUSH_DRIVER=console

# ---- Matching ----
MATCH_TIME_WINDOW_DAYS=14
MATCH_MIN_SCORE=35
